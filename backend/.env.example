# Backend settings. Copy to backend/.env (Docker Compose reads it) or export them. Every value is optional for a local
# run; the ones marked "production" must be set on any shared or public host.

# development (default) or production. Production refuses the public development signing key and allows no CORS
# origins unless they are listed below.
KNX_ENV=development

# production: HMAC key for session tokens, receipts and quality certificates. 32 or more random characters, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
KNX_RECEIPT_SIGNING_KEY=

# production: password for the ADMIN-01 account. Unset, admins log in like the other demo accounts.
KNX_ADMIN_PASSWORD=

# Comma-separated origins allowed to call the API from a browser. Unset = any origin in development, none in production.
# KNX_CORS_ORIGINS=https://example.org

# Weather: Open-Meteo forecast endpoint, request timeout, and a switch to the offline climatology fallback.
KNX_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
KNX_HTTP_TIMEOUT_SECONDS=8.0
KNX_FORCE_OFFLINE_WEATHER=false

# Online Bangla voice for POST /edge/tts (on/off). Off keeps every request on the node.
KNX_ONLINE_TTS=on

# Folder for runtime state (accounts, market, escrows, feedback). Default: backend/.state
# KNX_STATE_DIR=

# Local LLM runtimes the edge node probes.
KNX_OLLAMA_HOST=http://localhost:11434
KNX_LLAMACPP_URL=http://localhost:8080
KNX_VLLM_URL=http://localhost:8001

# Trained models (git-ignored; see training/HOW_TO_TRAIN.md). Defaults are the folders under backend/models/.
# KNX_WHISPER_MODEL=
# KNX_YOLO_WEIGHTS=
# KNX_DIALECT_RETRIEVER=
# Optional sentence-transformers models; unset uses the built-in hashing embedder and reranker.
# KNX_EMBEDDING_MODEL=
# KNX_RERANKER_MODEL=
