# Copy to .env and adjust. All values are optional.
KNX_ENV=development
KNX_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
KNX_HTTP_TIMEOUT_SECONDS=8.0
# Set to true to skip Open-Meteo and use the deterministic climatology fallback.
KNX_FORCE_OFFLINE_WEATHER=false
# HMAC key used to sign digital warehouse receipts. Change for any shared deployment.
KNX_RECEIPT_SIGNING_KEY=knx-dev-receipt-signing-key-change-me
KNX_CORS_ORIGINS=*
