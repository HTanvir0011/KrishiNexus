# Copy to .env next to docker-compose.yml to change host ports or the Ollama image. All values are optional.
# Backend application settings belong in backend/.env (see backend/.env.example).
KNX_BACKEND_PORT=8000
KNX_FRONTEND_PORT=5173
KNX_OLLAMA_PORT=11434
# Point the backend at another Ollama server instead of the bundled local-llm profile.
KNX_OLLAMA_HOST=http://ollama:11434
OLLAMA_IMAGE_TAG=latest
# Profile data (docker compose --profile data up --build). Its ports bind to 127.0.0.1 only. The defaults are for a
# local demo; set your own passwords and n8n key for anything else.
KNX_PG_PORT=5432
KNX_PG_USER=krishinexus
KNX_PG_PASSWORD=krishinexus-dev
KNX_NEO4J_HTTP_PORT=7474
KNX_NEO4J_BOLT_PORT=7687
KNX_NEO4J_PASSWORD=krishinexus-dev
KNX_N8N_PORT=5678
KNX_N8N_ENCRYPTION_KEY=krishinexus-dev-only-key
N8N_IMAGE_TAG=latest
