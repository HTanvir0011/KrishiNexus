# Copy to .env next to docker-compose.yml to change host ports or the Ollama image. All values are optional.
# Backend application settings belong in backend/.env (see backend/.env.example).
KNX_BACKEND_PORT=8000
KNX_FRONTEND_PORT=5173
KNX_OLLAMA_PORT=11434
# Point the backend at another Ollama server instead of the bundled local-llm profile.
KNX_OLLAMA_HOST=http://ollama:11434
OLLAMA_IMAGE_TAG=latest
